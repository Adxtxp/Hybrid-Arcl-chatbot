{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Arcl": {
    "ConnectionString": "",
    "GeminiApiKey": "",
    "AdminApiKey": "",
    "ChatModel": "gemini-3.5-flash-lite",
    "EmbeddingModel": "gemini-embedding-2",
    "EmbeddingDimensions": 768,
    "RetrievalTopN": 10,
    "RetrievalCandidatesPerRanking": 30,
    "CorpusCacheMinutes": 10,
    "HighConfidenceCosineDistanceThreshold": 0.33,
    "MediumConfidenceCosineDistanceThreshold": 0.38,
    "OutOfScopeCosineDistanceThreshold": 0.40,
    "ConversationMemoryTurns": 4,
    "MaxMessageLength": 1000,
    "SupportContact": "arclorg@arcl.org",
    "HandoffConsentText": "",
    "RateLimitPermitsPerWindow": 20,
    "RateLimitWindowSeconds": 60,

    "Reranker": {
      "Enabled": true,
      "ModelDirectory": "models/ms-marco-MiniLM-L6-v2",
      "Candidates": 20,
      "MaxSequenceLength": 384
    },

    "OutputFilter": {
      "AllowedHosts": [ "arcl.org", "cricclubs.com" ]
    },

    "Security": {
      "RequireHttps": true,
      "TrustForwardedHeaders": false,
      "AllowedOrigins": [],
      "FrameAncestors": "https://arcl.org https://*.arcl.org"
    }
  },

  "OpenTelemetry": {
    "ServiceName": "ArclChatbot.Api",
    "OtlpEndpoint": ""
  }
}
