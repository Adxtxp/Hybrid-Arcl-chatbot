<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Arcl.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- v10+ required for native SqlDbType.Vector / SqlVector<float> support -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />

    <!-- Team ranking lookup (TeamRankingService.cs) — parses arcl.org/Pages/UI/TeamHistory.aspx,
         same version already validated in ingest/Ingest.csproj -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />

    <!-- Telemetry (Phase 5) -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />

    <!-- Rate limiting is built into ASP.NET Core 8 (Microsoft.AspNetCore.RateLimiting), no package needed -->
  </ItemGroup>

</Project>
