<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Arcl.Api</RootNamespace>
    <!-- Enables `dotnet user-secrets set Arcl:GeminiApiKey ...` for local development, so secrets
         never need to sit in appsettings.json or a shell profile. See README "Secrets". -->
    <UserSecretsId>arcl-chatbot-api-6f1c2b7e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arcl.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-encoder model files (scripts/download-reranker.ps1, gitignored) ship with a publish
         so the re-ranker works on the server too, not just under `dotnet run`. -->
    <None Include="models\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- v10+ required for native SqlDbType.Vector / SqlVector<float> support -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <!-- Pinned above SqlClient's transitive 9.0.13, which has known vulnerabilities
         (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). Drop once SqlClient pulls a fixed version itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

    <!-- Team ranking lookup (TeamRankingService.cs) — parses arcl.org/Pages/UI/TeamHistory.aspx,
         same version already validated in ingest/Ingest.csproj -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />

    <!-- Telemetry (Phase 5) -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />

    <!-- Cross-encoder re-ranking (CrossEncoderReranker.cs) — runs ms-marco-MiniLM-L6-v2 locally on CPU -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />

    <!-- Rate limiting is built into ASP.NET Core 8 (Microsoft.AspNetCore.RateLimiting), no package needed -->
  </ItemGroup>

</Project>
