<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Arcl.Ingest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fetch/chunk/upsert/embed all live in the shared library (also used by the API's re-crawl). -->
